# ─────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ─────────────────────────────────────────────────────────────
# TalkingHead / 3D Assets
# ─────────────────────────────────────────────────────────────

# TalkingHead library bundle — large file, comes from npm / CDN, not source code
public/talkinghead/modules/
!public/talkinghead/modules/
public/talkinghead/modules/*
!public/talkinghead/modules/mindmitra-rig-preprocess.mjs

# 3D avatar models — large binary assets, track via Git LFS or external storage
# Uncomment the line below if you move GLBs to a CDN/LFS
# public/talkinghead/avatars/*.glb

# Misplaced secrets file inside public/ — already covered by .env.local rule
# but listed explicitly so it's obvious
public/talkinghead/.env.local

# ─────────────────────────────────────────────────────────────
# Project-Specific (Keep these out of Git)
# ─────────────────────────────────────────────────────────────

# Old/redundant code files (can be deleted)
chatbotAgent/workflow2.py
chatbotAgent/Untitled-1.ini
chatbotAgent/models/state.py
chatbotAgent/test_rag_pipeline.py
# chatbotAgent/.railway.toml
# chatbotAgent/railway.toml

# Test files (optional - uncomment to ignore)
# chatbotAgent/test_*.py
# *_test.py
chatbotAgent/evaluations/history/runs.jsonl
chatbotAgent/rag_evaluation_report.json
chatbotAgent/memory_benchmark_report.json
chatbotAgent/memory_benchmark_report.isolated.json
