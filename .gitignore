node_modules/
dist/
dist-ssr/
.tools/
*.local
.vite/
.vercel/
vite.config.ts.timestamp-*.mjs

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─────────────────────────────────────────────────────────────
# Python / Backend (FastAPI + uvicorn)
# ─────────────────────────────────────────────────────────────

# Virtual Environments (uv pip or standard venv)
.venv/
venv/
env/
ENV/
chatbotAgent/venv/
chatbotAgent/.venv/

# Python compiled files
__pycache__/
*.py[cod]
*.pyo
*.pyd
*$py.class
*.so
.Python

# Python cache and build
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
!src/lib/
!src/pages/mindgym/tools/campus-ludo/lib/
!src/pages/mindgym/tools/campus-ludo/lib/**
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Unit test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
coverage.xml
*.cover

# ─────────────────────────────────────────────────────────────
# Environment Variables & Secrets
# ─────────────────────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
*.env
!.env.example
!.env.production.example

# Credentials
credentials_base64.txt
chatbotAgent/credentials_base64.txt
chatbotAgent/mindmitra-tts-7909061416cd.json
*.pem
*.key
*.crt

# ─────────────────────────────────────────────────────────────
# Database & User Data
# ─────────────────────────────────────────────────────────────
chatbotAgent/user_contexts/
supabase/.temp/
*.db
*.sqlite
*.sqlite3

