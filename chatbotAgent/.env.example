# MindMitra backend secrets and platform env.
#
# Runtime behavior lives in config.yaml. Keep this file limited to secrets,
# platform-injected values, and rare local overrides.

# ── App / server envelope ─────────────────────────────────────
PORT=8000
HOST=0.0.0.0
ENV=development              # development | production
# UVICORN_RELOAD=1           # local only

# ── Supabase secrets ──────────────────────────────────────────
SUPABASE_SERVICE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-jwt-secret"
SECRET_KEY="replace-with-a-long-random-secret"

# ── Redis connection ──────────────────────────────────────────
# Often includes credentials in hosted environments, so keep it in env.
# Local: redis://localhost:6379/0
# Upstash: use rediss:// only (TLS). redis:// against *.upstash.io fails startup validation.
# Do not use the HTTPS REST URL here.
REDIS_URL="redis://localhost:6379/0"
# Session expiry: auto | listener | sweep (Upstash / managed Redis: sweep)
# REDIS_KEYSPACE_MODE=sweep

# ── Provider secrets ──────────────────────────────────────────
AZURE_OPENAI_API_KEY=""
GROQ_API_KEY=""
GEMINI_API_KEY=""
GLM_API_KEY=""

# ── Optional service secrets ──────────────────────────────────
QDRANT_API_KEY=""
AZURE_SPEECH_KEY=""
# AZURE_TTS_KEY=""           # legacy alias supported
SENTRY_DSN=""
POSTHOG_API_KEY=""

# ── Admin / debug secrets ─────────────────────────────────────
DEBUG_MEMORY_TOKEN=""
V3_ADMIN_KEY=""

# ── Google credential passthrough, only if a consumer needs gcloud ─
GOOGLE_CREDENTIALS_BASE64=""
GOOGLE_APPLICATION_CREDENTIALS=""

# ── Emergency/local overrides ─────────────────────────────────
# Prefer config.yaml for these non-secret values. They remain supported here
# only so tests and deployments can override behavior without rebuilding.
# SUPABASE_URL="https://your-project-id.supabase.co"
# QDRANT_URL="http://localhost:6333"
# AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com"
# AZURE_OPENAI_DEPLOYMENT_NAME="gpt-5-mini"
# SKIP_AUTH=true
# CHAT_DAILY_LIMIT=1000
# CORS_ALLOW_ORIGINS="https://preview.example.com"
