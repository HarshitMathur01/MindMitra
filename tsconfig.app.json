{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": false,
    "noFallthroughCasesInSwitch": false,

    "baseUrl": ".",
    "paths": {
      "lucide-react": ["./src/lib/lucide-react.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  // Tests are not part of the app compile: they import a runner (vitest) that
  // is not an app dependency. Give them their own config if a runner is wired.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
