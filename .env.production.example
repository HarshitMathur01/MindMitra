# Production Frontend Variables (for Vercel)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# HTTP base for the chatbotAgent FastAPI service. The chat surface posts to
# `${VITE_BACKEND_URL}/chat`.
VITE_BACKEND_URL="https://your-backend-url.railway.app"

# Browser-side voice. Restrict these keys by domain/provider policy or proxy
# them before broad production traffic.
VITE_AZURE_TTS_KEY="your-azure-tts-key"
VITE_AZURE_TTS_REGION="eastasia"
VITE_GOOGLE_TTS_KEY="your-google-tts-key"

# Product analytics (Mixpanel + Supabase product_events) — off unless all set
# VITE_ENABLE_PRODUCT_ANALYTICS=1
# VITE_MIXPANEL_TOKEN="your-mixpanel-project-token"
# VITE_MIXPANEL_API_HOST="https://api-eu.mixpanel.com"

# Sanctuary remote signals. Flip each to "true" only once the matching
# backend piece is live:
#   MOOD_LOGS_REMOTE  -> after the mood_logs migration is applied in Supabase
#   SNAPSHOT_REMOTE   -> after /me/snapshot is deployed on Railway
# Both off by default keeps the dev console clean when running against an
# un-migrated / un-deployed backend.
VITE_SANCTUARY_MOOD_LOGS_REMOTE="false"
VITE_SANCTUARY_SNAPSHOT_REMOTE="false"
