{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cd:*)",

      "Bash(npm run build)",
      "Bash(npm run build:*)",
      "Bash(npm run lint)",
      "Bash(npm run lint:*)",
      "Bash(npm run check:node)",
      "Bash(npm run preview)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx tsc -p:*)",
      "Bash(node scripts/check-banned-words.mjs)",
      "Bash(node scripts/check-node-version.mjs)",
      "Bash(node scripts/with-supported-node.mjs:*)",
      "PowerShell(npm run build)",
      "PowerShell(npm run lint:*)",
      "PowerShell(npx tsc -p:*)",

      "Bash(python -m pytest:*)",
      "Bash(pytest:*)",
      "Bash(python -m tests.memory_retrieval_benchmark)",
      "Bash(python --version)",
      "PowerShell(python -m pytest:*)",

      "Bash(make help)",
      "Bash(make test-health)",
      "Bash(make test-health-fast)",
      "Bash(make test-health-full)",
      "Bash(make memory-bench)",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git grep:*)",
      "Bash(git ls-files:*)",
      "Bash(git check-ignore:*)",
      "Bash(git rev-parse:*)",
      "Bash(git remote -v)",
      "Bash(git stash list)",
      "Bash(git branch)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",

      "Bash(npx --yes serve -s dist:*)",
      "Bash(npx serve -s dist:*)",
      "Bash(npx --yes lighthouse@12:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(curl -s http://127.0.0.1:*)",
      "Bash(curl -s -o /dev/null -w:*)"
    ]
  }
}
