# Production Frontend Variables (for Vercel)
VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_BACKEND_URL="https://your-backend-url.railway.app"

# Azure Cognitive Services TTS
VITE_AZURE_TTS_KEY="your-azure-tts-key"
VITE_AZURE_TTS_REGION="eastus"

# Product analytics (Mixpanel + Supabase product_events) — off unless all set
# VITE_ENABLE_PRODUCT_ANALYTICS=1
# VITE_MIXPANEL_TOKEN="your-mixpanel-project-token"
# VITE_MIXPANEL_API_HOST="https://api-eu.mixpanel.com"
