# MindMitra backend secrets and platform env.
#
# Runtime behavior lives in config.yaml. Keep this file limited to secrets,
# platform-injected values, and rare local overrides.

# ── App / server envelope ─────────────────────────────────────
PORT=8000
HOST=0.0.0.0
ENV=development              # development | production
# UVICORN_RELOAD=1           # local only

# ── Supabase secrets ──────────────────────────────────────────
SUPABASE_SERVICE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-jwt-secret"
SECRET_KEY="replace-with-a-long-random-secret"

# ── Redis connection ──────────────────────────────────────────
# Often includes credentials in hosted environments, so keep it in env.
# Local: redis://localhost:6379/0
# Upstash / Railway: copy the TLS URL from the Upstash console (rediss://…). Plain
# redis:// to *.upstash.io fails validation and causes "Connection closed by server" at runtime.
# Do not use the HTTPS REST URL here.
REDIS_URL="redis://localhost:6379/0"
# Session expiry: auto | listener | sweep (Upstash / managed Redis: sweep)
# REDIS_KEYSPACE_MODE=sweep

# ── Provider secrets ──────────────────────────────────────────
AZURE_OPENAI_API_KEY=""
GROQ_API_KEY=""
GEMINI_API_KEY=""
GLM_API_KEY=""

# ── Optional service secrets ──────────────────────────────────
QDRANT_API_KEY=""
AZURE_SPEECH_KEY=""
# AZURE_TTS_KEY=""           # legacy alias supported
SENTRY_DSN=""
POSTHOG_API_KEY=""

# ── Anam.ai hosted avatar ─────────────────────────────────────
# Required for the chat avatar. The key stays server-side: GET
# /anam/session-token exchanges it for a short-lived session token so the
# browser never sees it. The persona itself (voice, turn-taking, greeting,
# director notes, tools) lives in config.yaml under `avatar:` — see
# docs/anam-avatar.md.
ANAM_API_KEY=""
# ANAM_API_BASE="https://api.anam.ai/v1"
# ANAM_TIMEOUT_S=8.0
# Overrides avatar.anam_llm_id. Blank = whatever config.yaml says.
# ANAM_LLM_ID=""
# Overrides avatar.session.daily_limit_seconds — the per-account daily Anam
# video quota (resets at IST midnight). Default 600 (10 min).
# ANAM_DAILY_LIMIT_SECONDS=600

# ── Therapist Bridge ──────────────────────────────────────────
# Lifetime of the unauthenticated clinician magic-link token, in days. The
# token travels in the URL path, so it reaches access logs whatever we do —
# a bounded lifetime is the mitigation that holds. Default 14.
THERAPIST_BRIDGE_TOKEN_TTL_DAYS="14"
# Deadline on the synchronous profile-synthesis call. Default 8.0.
THERAPIST_BRIDGE_BLOCKING_TIMEOUT_S="8.0"

# ── Admin / debug secrets ─────────────────────────────────────
DEBUG_MEMORY_TOKEN=""
V3_ADMIN_KEY=""

# ── Google credential passthrough, only if a consumer needs gcloud ─
GOOGLE_CREDENTIALS_BASE64=""
GOOGLE_APPLICATION_CREDENTIALS=""

# ── Sanctuary ambient personalization ─────────────────────────
# Hours the SanctuaryHome landing page stays in "crisis quiet" mode after a
# session ends with peak_urgency >= 2. The flag is also cleared earlier if
# the next session opens with valence > 0 / urgency 0 / >= 6h elapsed.
# CRISIS_COOLDOWN_HOURS=24

# ── Emergency/local overrides ─────────────────────────────────
# Prefer config.yaml for these non-secret values. They remain supported here
# only so tests and deployments can override behavior without rebuilding.
# SUPABASE_URL="https://your-project-id.supabase.co"
# QDRANT_URL="http://localhost:6333"
# AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com"
# AZURE_OPENAI_DEPLOYMENT_NAME="gpt-5-mini"
# SKIP_AUTH=true
# CHAT_DAILY_LIMIT=1000
# CORS_ALLOW_ORIGINS="https://preview.example.com"
