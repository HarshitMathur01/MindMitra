# ══════════════════════════════════════════════════════════════
# MindMitra — Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env — it contains secrets.
# ══════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"   # used by backend
SUPABASE_KEY="your-service-role-key"                # alias read by config.py
SUPABASE_JWT_SECRET="your-jwt-secret"               # used for auth token validation

# ── LLM Providers ─────────────────────────────────────────────
ZAI_API_KEY="your-zhipuai-glm-key"         # ZhipuAI / GLM-4 (response gen, psych analysis)
GROQ_API_KEY="your-groq-key"               # Groq (NLP, routing, cultural analysis, screening)
GOOGLE_API_KEY="your-google-api-key"       # Gemini (session summaries)
GEMINI_API_KEY="your-gemini-key"           # Alternative Gemini key (same project usually)

# ── Memory System (mem0 + Qdrant) ─────────────────────────────
# localhost: run `docker run -p 6333:6333 qdrant/qdrant` then use localhost
# Railway:   prefer QDRANT_URL (private or public), host/port kept for backward compatibility
QDRANT_URL=""                           # e.g. http://qdrant.railway.internal:6333
QDRANT_FALLBACK_URL=""                  # optional public URL if private DNS is unavailable
QDRANT_HOST="localhost"                 # used when QDRANT_URL is empty
QDRANT_PORT="6333"
QDRANT_COLLECTION="companion_memories"

# Embedding model must match the Qdrant collection vector size for QDRANT_COLLECTION.
# Put these in chatbotAgent/.env (not only repo-root .env) if chatbotAgent/.env already exists —
# duplicate keys in chatbotAgent/.env win over MindMitra/.env.
# Default: BAAI/bge-m3 (1024). Legacy mem0 + MiniLM collections (384):
# EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
# EMBEDDING_DIMS=384
EMBEDDING_MODEL="BAAI/bge-m3"
EMBEDDING_DIMS="1024"

# ── Google Cloud Credentials (for Google TTS / Vertex AI) ─────
# Option A — file path (local dev)
GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"
# Option B — base64-encoded JSON (Railway / any cloud env)
GOOGLE_CREDENTIALS_BASE64=""            # base64 of the service-account JSON

# ── ElevenLabs TTS (optional, falls back to gTTS if not set) ──
ELEVENLABS_API_KEY="your-elevenlabs-key"
ELEVENLABS_VOICE_ID="your-voice-id"
ELEVENLABS_MODEL_ID="eleven_multilingual_v2"

# ── App / Server ───────────────────────────────────────────────
PORT=8000
LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR
SKIP_AUTH=false         # set true for local dev to bypass JWT checks
CORS_ALLOW_ORIGINS=""   # comma-separated extra origins (added to hardcoded whitelist)

# ── Response + memory (production) ─────────────────────────────
# COMPASS (response) and MEMOIR (retrieval + structured extraction) are always on in code.
# Optional: MM_MEMORY_TRACE, MM_MEMOIR_DEBUG, MM_PIPELINE_DEBUG (see logging in agents).
# REDIS_URL=redis://localhost:6379/0   # optional: session turn ring + extraction throttle + memory_context cache (see config.yaml memory.*)
